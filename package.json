{
  "name": "c-snippet",
  "version": "2.2.0",
  "description": "Convert snippets from any code editor (TS)",
  "main": "index.js",
  "author": {
    "name": "FragnaroK",
    "email": "fcanalejo2000@outlook.com",
    "url": "https://francocanalejo.com"
  },
  "homepage": "https://github.com/FragnaroK/c-snippet",
  "bugs": {
    "url": "https://github.com/FragnaroK/c-snippet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FragnaroK/c-snippet.git"
  },
  "bin": "./lib/cli/cli.js",
  "files": [
    "lib/**/*",
    "assets/**/*"
  ],
  "keywords": [
    "snippet",
    "converter",
    "code",
    "editor",
    "vscode",
    "sublime",
    "atom",
    "cson",
    "json",
    "xml",
    "yaml",
    "ts",
    "typescript"
  ],
  "scripts": {
    "start": "pnpm build && SET NODE_ENV=development && node lib/cli/cli.js",
    "start:linux": "pnpm build && NODE_ENV=development node lib/cli/cli.js",
    "test:oneline": "pnpm build && SET NODE_ENV=development && node ./lib/cli/cli.js -f \"vscode\" -t \"sublime\" -s \"./src/__tests__/snippets/snippets.code-snippets\" -o \"./src/__tests__/snippets/converted\"",
    "test:oneline:linux": "pnpm build && NODE_ENV=development node ./lib/cli/cli.js -f \"vscode\" -t \"sublime\" -s \"./src/__tests__/snippets/snippets.code-snippets\" -o \"./src/__tests__/snippets/converted\"",
    "test:oneline:linux:prod": "pnpm build && NODE_ENV=production node ./lib/cli/cli.js -f \"vscode\" -t \"sublime\" -s \"./src/__tests__/snippets/snippets.code-snippets\" -o \"./src/__tests__/snippets/converted\"",
    "build": "swc build ./src -d lib",
    "test": "pnpx jest --config jest.config.js",
    "repo:commit": "git add . && git commit && git push origin",
    "deploy": "pnpm build && pnpm publish --access=public"
  },
  "license": "MIT",
  "devDependencies": {
    "@jest-performance-reporter/core": "^2.1.3",
    "@jest/globals": "^29.7.0",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.15",
    "@types/figlet": "^1.7.0",
    "@types/jest": "^29.5.14",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^22.13.1",
    "@types/ora": "^3.2.0",
    "@types/xml2js": "^0.4.14",
    "@types/yargs": "^17.0.33",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tslint": "^5.20.1",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.3.1",
    "chalk": "4.1.2",
    "cli-spinners": "^2.9.0",
    "cson-parser": "^4.0.9",
    "figlet": "^1.8.0",
    "htmlparser2": "^10.0.0",
    "log-symbols": "^7.0.0",
    "node-logger-cli": "^1.0.6",
    "ora": "^3.2.0",
    "xml2js": "^0.6.2",
    "yargs": "^17.7.2"
  }
}
